# Copy to .env (git-ignored). TLM reads it from the directory of the config file,
# or from --env-file / TLM_ENV_FILE. Values are only used through ${VAR} references in
# config.yaml; real environment variables take precedence over this file.
# Changes are picked up by hot reload.

# Provider API keys
OPENAI_API_KEY=
GROQ_API_KEY=

# Server (optional; defaults come from config.yaml)
# TLM_HOST=0.0.0.0
# TLM_PORT=30000
# TLM_REQUEST_TIMEOUT_MS=600000
# TLM_LOG_LEVEL=info

# Outbound proxy (optional)
# HTTPS_PROXY=http://user:pass@proxy.internal:3128

# Route overrides (optional)
# DOCUMENTS_MODEL=gpt-4.1
