{
  "name": "tlm",
  "version": "0.1.0",
  "description": "Tiny LLM Router: an OpenAI-compatible API that routes requests across OpenAI-compatible providers with strategies and fallbacks.",
  "author": "Pablo Medina",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "openai",
    "llm",
    "router",
    "proxy",
    "fallback",
    "load-balancer",
    "gateway"
  ],
  "files": [
    "dist",
    "config.example.yaml",
    "LICENSE",
    "README.md"
  ]
}
